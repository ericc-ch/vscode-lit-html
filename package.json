{
  "name": "lit-html",
  "displayName": "lit-html",
  "version": "1.12.0",
  "private": true,
  "description": "Syntax highlighting and IntelliSense for html inside of JavaScript and TypeScript tagged template strings",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "lit-html",
    "javascript",
    "typescript",
    "html",
    "template"
  ],
  "bugs": {
    "url": "https://github.com/ericc-ch/vscode-lit-html/issues"
  },
  "repository": {
    "url": "https://github.com/ericc-ch/vscode-lit-html.git",
    "type": "git"
  },
  "license": "MIT",
  "author": {
    "name": "Erick Christian",
    "email": "erickchristian48@gmail.com"
  },
  "publisher": "ericc-ch",
  "type": "module",
  "main": "./out/index.cjs",
  "scripts": {
    "compile": "rollup -c",
    "lint": "eslint .",
    "test": "vscode-test",
    "vscode:prepublish": "rollup -c",
    "watch": "rollup -c -w"
  },
  "contributes": {
    "configuration": [
      {
        "id": "lit-html",
        "title": "Lit HTML",
        "properties": {
          "lit-html.tags": {
            "type": "array",
            "description": "List of template tags to enable html intellisense in.",
            "items": {
              "type": "string",
              "description": "Tag name."
            },
            "default": [
              "html",
              "raw"
            ]
          },
          "lit-html.cssTags": {
            "type": "array",
            "description": "List of template tags to enable css intellisense in.",
            "items": {
              "type": "string",
              "description": "Tag name."
            },
            "default": [
              "css"
            ]
          },
          "lit-html.format.enabled": {
            "type": "boolean",
            "description": "Enable/disable formatting of html template strings.",
            "default": true
          }
        }
      }
    ],
    "grammars": [
      {
        "injectTo": [
          "source.js",
          "source.js.jsx",
          "source.jsx",
          "source.ts",
          "source.tsx",
          "text.html.basic"
        ],
        "scopeName": "inline.lit-html",
        "path": "./syntaxes/lit-html.json",
        "embeddedLanguages": {
          "meta.embedded.block.html": "html",
          "meta.embedded.block.css": "css",
          "source.css": "css"
        }
      },
      {
        "injectTo": [
          "source.js",
          "source.js.jsx",
          "source.jsx",
          "source.ts",
          "source.tsx",
          "text.html.basic"
        ],
        "scopeName": "inline.lit-html.string.injection",
        "path": "./syntaxes/lit-html-string-injection.json",
        "embeddedLanguages": {
          "meta.template.expression.ts": "typescript"
        }
      },
      {
        "injectTo": [
          "source.js",
          "source.js.jsx",
          "source.jsx",
          "source.ts",
          "source.tsx",
          "text.html.basic"
        ],
        "scopeName": "inline.lit-html.style.injection",
        "path": "./syntaxes/lit-html-style-injection.json",
        "embeddedLanguages": {
          "meta.template.expression.ts": "typescript"
        }
      },
      {
        "injectTo": [
          "source.js",
          "source.js.jsx",
          "source.jsx",
          "source.ts",
          "source.tsx",
          "text.html.basic"
        ],
        "scopeName": "inline.lit-html-svg",
        "path": "./syntaxes/lit-html-svg.json",
        "embeddedLanguages": {
          "meta.embedded.block.svg": "xml"
        }
      },
      {
        "injectTo": [
          "source.js",
          "source.js.jsx",
          "source.jsx",
          "source.ts",
          "source.tsx",
          "text.html.basic"
        ],
        "scopeName": "inline.lit-html-css",
        "path": "./syntaxes/lit-html-css.json",
        "embeddedLanguages": {
          "meta.embedded.block.css": "css"
        }
      }
    ],
    "typescriptServerPlugins": [
      {
        "name": "typescript-lit-html-plugin",
        "enableForWorkspaceTypeScriptVersions": true
      },
      {
        "name": "@styled/typescript-styled-plugin",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ]
  },
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "dependencies": {
    "@styled/typescript-styled-plugin": "^1.0.1",
    "typescript-lit-html-plugin": "0.9.0"
  },
  "devDependencies": {
    "@echristian/eslint-config": "^0.0.53",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/node": "^22.17.2",
    "@types/vscode": "^1.103.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.33.0",
    "mocha": "^11.7.1",
    "rollup": "^4.47.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2"
  },
  "engines": {
    "vscode": "^1.103.0"
  },
  "icon": "docs/logo.png",
  "galleryBanner": {
    "color": "#fcfcfc",
    "theme": "light"
  }
}
